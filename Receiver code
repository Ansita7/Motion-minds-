
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

#define RELAY_PIN 26
#define WIFI_CHANNEL 1

// Many relay boards are active LOW.
// If your board is active HIGH, swap these two values.
#define RELAY_ON  LOW
#define RELAY_OFF HIGH

volatile int receivedCommand = -1;

void onDataReceived(
  const esp_now_recv_info_t *info,
  const uint8_t *data,
  int len
) {
  if (len != 1) return;

  uint8_t command = data[0];

  if (command == 0 || command == 1) {
    receivedCommand = command;
  }
}

void setup() {
  Serial.begin(115200);

  // Set relay to OFF before normal operation.
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF);

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  Serial.print("Receiver MAC: ");
  Serial.println(WiFi.macAddress());

  esp_wifi_set_channel(WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW initialization failed!");
    while (true) delay(1000);
  }

  if (esp_now_register_recv_cb(onDataReceived) != ESP_OK) {
    Serial.println("Receive callback registration failed!");
    while (true) delay(1000);
  }

  Serial.println("Receiver ready. Light is OFF.");
}

void loop() {
  // Process commands outside the ESP-NOW callback.
  int command = -1;

  noInterrupts();
  command = receivedCommand;
  receivedCommand = -1;
  interrupts();

  if (command == 1) {
    digitalWrite(RELAY_PIN, RELAY_ON);
    Serial.println("LIGHT ON - Relay activated");
  } else if (command == 0) {
    digitalWrite(RELAY_PIN, RELAY_OFF);
    Serial.println("LIGHT OFF - Relay deactivated");
  }

  delay(10);
}
